<resources>
    <string name="app_name">Meerkly</string>

    <!-- Auth gate -->
    <string name="gate_title">Hi! Let\'s sign you in</string>
    <string name="gate_text">Meerkly helps out from your phone while you\'re not using it. Sign in with your Meerkly account and you\'re good to go.</string>
    <string name="gate_cta">Sign in</string>
    <string name="gate_cta_busy">Signing in…</string>
    <string name="gate_hint">This opens your browser so you can sign in safely.</string>
    <string name="gate_no_browser">No browser found on this device to sign in with.</string>

    <!-- Dashboard -->
    <string name="dash_title">You\'re all set!</string>
    <string name="dash_sub">Meerkly is running quietly in the background and helping out — even when your screen is off. You don\'t need to do a thing.</string>
    <string name="dash_title_connecting">Connecting…</string>
    <string name="dash_sub_connecting">Meerkly is reaching out to the network. This usually only takes a moment.</string>
    <string name="dash_title_offline">Can\'t reach Meerkly</string>
    <string name="dash_sub_offline">You\'re not helping out right now. Meerkly keeps trying in the background and picks up again on its own — your earnings are safe in the meantime.</string>

    <!-- Account not yet linked to a publisher id (sign-in succeeded, /api/v1/me didn't) -->
    <string name="account_not_ready_note">We\'re still setting up your account. This usually only takes a moment.</string>
    <string name="account_not_ready_retry">Try again</string>

    <!-- Proxy connection chip -->
    <string name="conn_connected">Connected</string>
    <string name="conn_connecting">Connecting…</string>
    <string name="conn_offline">Offline</string>
    <string name="conn_disabled">Off</string>

