    <string name="earn_unknown_note">Can\'t load right now</string>
    <string name="earnings_unavailable_title">Can\'t load your earnings</string>
    <string name="earnings_unavailable_note">Your earnings are stored on your Meerkly account and are safe — the app just can\'t reach the server right now. They\'ll reappear once it reconnects.</string>
    <string name="dash_sign_out">Sign out</string>
    <string name="ready_to_earn">✓ Ready to earn</string>

