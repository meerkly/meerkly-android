<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for API <= 30. See data_extraction_rules.xml for 31+.

  `meerkly_prefs` is excluded on purpose and must stay excluded. It holds two
  things that are per-INSTALL, not per-user:

  * machineId — the gateway keys live worker connections by it
    (dispatch.workers[machineID]). Restoring a backup onto a second device
    would put two live workers on one id and silently orphan one of them.
  * The device token, encrypted with an AndroidKeyStore key that by design
    never leaves the device — the restored ciphertext would be undecryptable.

  A restored install is meant to mint a fresh machineId and re-pair.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="meerkly_prefs.xml" />
</full-backup-content>
